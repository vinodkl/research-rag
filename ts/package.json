{
  "name": "research-rag-ts",
  "private": true,
  "type": "module",
  "description": "Learning port of research-rag's local ingestion pipeline (parse -> chunk -> embed -> index), built one stage at a time.",
  "scripts": {
    "fetch": "tsx src/offline/1-fetch.ts",
    "parse": "tsx src/offline/2-parse/index.ts",
    "chunk": "tsx src/offline/3-chunk.ts",
    "embed": "tsx src/offline/4-embed.ts",
    "validate-index": "tsx src/offline/5-validate-index.ts",
    "search": "tsx src/retrieval/search-cli.ts",
    "ask": "tsx src/generation/ask.ts",
    "ingest": "tsx src/offline/ingest.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mupdf": "^1.28.0",
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
