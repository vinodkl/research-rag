# Copy to .env for local work, then export it before running the command:
#   set -a && source .env && set +a
# The application reads secrets from the process environment only.
OPENAI_API_KEY=

# Quality-first OpenAI defaults.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CAPTION_MODEL=gpt-5.6-luna
OPENAI_QUERY_MODEL=gpt-5.6-sol
OPENAI_RERANK_MODEL=gpt-5.6-sol
OPENAI_GENERATION_MODEL=gpt-5.6-sol
OPENAI_EVAL_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# Vector store. FAISS is the zero-infrastructure teaching default. Switch to
# Qdrant when several application replicas need one shared, managed index.
RAG_VECTOR_BACKEND=faiss

# Used only when RAG_VECTOR_BACKEND=qdrant. The collection value is a stable
# alias; ingestion writes a versioned physical collection behind it. A non-empty
# QDRANT_API_KEY requires an HTTPS URL.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=research-rag
QDRANT_TIMEOUT_SECONDS=10
QDRANT_INDEX_TIMEOUT_SECONDS=300
QDRANT_PREFER_GRPC=off
# Local/single-node defaults. Set both to 2 on a suitable multi-node cluster.
QDRANT_REPLICATION_FACTOR=1
QDRANT_WRITE_CONSISTENCY_FACTOR=1

# Retrieval controls. "auto" expands only complex/open-ended questions.
RAG_QUERY_MODE=auto
RAG_RERANK=on
RAG_PER_QUERY_K=20
RAG_CANDIDATE_K=20
RAG_CONTEXT_K=6

# Explicit runtime paths make wheel and container deployments independent of cwd.
# The source-checkout defaults are ./data and ./config/*.yaml.
# RAG_DATA_DIR=/var/lib/research-rag
# RAG_CORPUS_PATH=/etc/research-rag/papers.yaml
# RAG_GOLDEN_PATH=/etc/research-rag/golden_questions.yaml

# API and ingestion operations.
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8477
RAG_LOG_LEVEL=INFO
RAG_DOWNLOAD_TIMEOUT_SECONDS=60
RAG_DOWNLOAD_RETRIES=2
